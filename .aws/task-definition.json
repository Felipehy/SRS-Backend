{
  "family": "srs-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/srs-backend-task-role",
  "containerDefinitions": [
    {
      "name": "srs-backend",
      "image": "<AWS_ACCOUNT_ID>.dkr.ecr.sa-east-1.amazonaws.com/srs-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "COGNITO_ISSUER_URI",
          "value": "https://cognito-idp.sa-east-1.amazonaws.com/<USER_POOL_ID>"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>?currentSchema=db_srs&ApplicationName=srs_app"
        },
        {
          "name": "APP_FRONTEND_URL",
          "value": "https://<FRONTEND_DOMAIN>/"
        },
        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "https://<FRONTEND_DOMAIN>"
        },
        {
          "name": "GLPI_API_URL",
          "value": "https://<GLPI_HOST>/apirest.php"
        },
        {
          "name": "MAIL_FLEET_ADDRESS",
          "value": "<frota@seu-dominio>"
        },
        {
          "name": "MAIL_RESERVATION_ADDRESS",
          "value": "<reservas@seu-dominio>"
        }
      ],
      "secrets": [
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<DB_SECRET_NAME>:username::"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<DB_SECRET_NAME>:password::"
        },
        {
          "name": "SPRING_FOREIGN_API_GLPI_GET_FULL_SESSION",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<GLPI_SECRET_NAME>:SPRING_FOREIGN_API_GLPI_GET_FULL_SESSION::"
        },
        {
          "name": "SPRING_FOREIGN_API_AUTHORIZATION",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<GLPI_SECRET_NAME>:SPRING_FOREIGN_API_AUTHORIZATION::"
        },
        {
          "name": "SPRING_FOREIGN_API_GLPI_APP_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<GLPI_SECRET_NAME>:SPRING_FOREIGN_API_GLPI_APP_TOKEN::"
        },
        {
          "name": "SMTP_SERVER",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<SMTP_SECRET_NAME>:SMTP_SERVER::"
        },
        {
          "name": "SMTP_PORT",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<SMTP_SECRET_NAME>:SMTP_PORT::"
        },
        {
          "name": "SMTP_USER",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<SMTP_SECRET_NAME>:SMTP_USER::"
        },
        {
          "name": "SMTP_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<SMTP_SECRET_NAME>:SMTP_PASSWORD::"
        },
        {
          "name": "SPRING_TEMPORARY_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:sa-east-1:<AWS_ACCOUNT_ID>:secret:<APP_SECRET_NAME>:SPRING_TEMPORARY_PASSWORD::"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/srs-backend",
          "awslogs-region": "sa-east-1",
          "awslogs-stream-prefix": "srs"
        }
      }
    }
  ]
}
