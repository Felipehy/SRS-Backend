SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://host.docker.internal:5432/srs?currentSchema=db_srs&ApplicationName=srs_app
SPRING_DATASOURCE_USERNAME=srs
SPRING_DATASOURCE_PASSWORD=troque-esta-senha

COGNITO_ISSUER_URI=https://cognito-idp.<regiao>.amazonaws.com/<user-pool-id>
SPRING_TEMPORARY_PASSWORD=<senha-temporaria-dos-novos-usuarios>
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

GLPI_API_URL=https://glpi.example.com/apirest.php
SPRING_FOREIGN_API_GLPI_GET_FULL_SESSION=true
SPRING_FOREIGN_API_AUTHORIZATION=user_token <token-do-usuario-glpi>
SPRING_FOREIGN_API_GLPI_APP_TOKEN=<app-token-glpi>

APP_FRONTEND_URL=http://localhost:5173/
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAIL_FLEET_ADDRESS=frota@example.com
MAIL_RESERVATION_ADDRESS=reservas@example.com

APP_EFS_BASE_PATH=/tmp/anexos
